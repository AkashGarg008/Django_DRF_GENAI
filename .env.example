# Copy this file to .env and fill in your values
# cp .env.example .env

# Django secret key — generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts, e.g. localhost,127.0.0.1,yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Database URL (default is SQLite)
# For PostgreSQL: postgres://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Max file upload size in bytes (default 5MB)
MAX_UPLOAD_SIZE=5242880

# Comma-separated allowed MIME types for file uploads
ALLOWED_FILE_TYPES=text/plain,application/pdf,application/json
